{
  "name": "arassaha-backend",
  "version": "1.0.0",
  "description": "ArasSaha staj prototipi - iş emri/arıza takip backend API'si (Node.js + Express + SQLite)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "test": "cross-env NODE_ENV=test node --test test/**/*.test.js",
    "test:coverage": "cross-env NODE_ENV=test node --test --experimental-test-coverage test/**/*.test.js",
    "test:watch": "cross-env NODE_ENV=test node --test --watch test/**/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.4.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2"
  }
}
